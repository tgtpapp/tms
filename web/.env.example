# Cấu hình môi trường của giao diện. Chép thành .env.local để chạy trên máy.
# Chỉ đặt giá trị CÔNG KHAI ở đây. Không bao giờ đặt khóa bí mật hay mật khẩu DB.

# Tên hiển thị của nền tảng (đổi thương hiệu chỉ cần sửa dòng này)
# Tên app khi cài vào máy (để trống = VITE_APP_NAME)
VITE_INSTALL_NAME=
VITE_APP_NAME=TMS

# Tên môi trường: production | staging | local
VITE_APP_ENV=local

# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Mã nhà xe của trang web này (đăng nhập bằng số điện thoại)
VITE_TENANT_CODE=thinh-phat

# Tên miền email nội bộ cho đăng nhập bằng SĐT (phải giống Edge Function)
VITE_LOGIN_EMAIL_DOMAIN=login.tms.invalid

# Giới hạn dung lượng gói Supabase (MB) để hiện cảnh báo ở Cấu hình → Dung lượng. Đổi gói thì sửa 2 dòng này.
VITE_DB_LIMIT_MB=500
VITE_FILE_LIMIT_MB=1024
VITE_NEON_LIMIT_MB=1024
# Dòng ghi công cuối thanh menu (để trống = không hiện)
VITE_CREDIT=

# Tra tọa độ tạm cho điểm dừng theo tên / địa chỉ (trợ lý giọng nói nhắc sắp tới điểm). Để trống = chỉ học từ GPS lái xe.
VITE_GEOCODE_URL=https://nominatim.openstreetmap.org

# Ảnh nền bản đồ cho màn Vị trí xe ({z}/{x}/{y}). Để trống = chỉ hiện danh sách xe.
VITE_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
