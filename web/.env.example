# Cấu hình môi trường của giao diện. Chép thành .env.local để chạy trên máy.
# Chỉ đặt giá trị CÔNG KHAI ở đây. Không bao giờ đặt khóa bí mật hay mật khẩu DB.

# Tên hiển thị của nền tảng (đổi thương hiệu chỉ cần sửa dòng này)
VITE_APP_NAME=TMS

# Tên môi trường: production | staging | local
VITE_APP_ENV=local

# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Mã nhà xe của trang web này (đăng nhập bằng số điện thoại)
VITE_TENANT_CODE=thinh-phat

# Tên miền email nội bộ cho đăng nhập bằng SĐT (phải giống Edge Function)
VITE_LOGIN_EMAIL_DOMAIN=login.tms.invalid
